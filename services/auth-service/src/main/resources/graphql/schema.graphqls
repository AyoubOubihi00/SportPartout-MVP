extend schema
@link(url: "https://specs.apollo.dev/federation/v2.6", import: ["@key"])

scalar DateTime

type Mutation {
    register(input: RegisterInput!): MessageResponse!
    login(input: LoginInput!): AuthPayload!
    updateUser(input: UpdateUserInput!): MessageResponse!
}

input RegisterInput {
    email: String!
    password: String!
    lastName: String!
    firstName: String!
    birthDate: DateTime!
    phone: String!
}

input UpdateUserInput {
    firstName: String
    lastName: String
    birthDate: DateTime
    phone: String
}

input LoginInput {
    email: String!
    password: String!
}

type AuthPayload {
    token: String!
}

type MessageResponse {
    message: String!
}



type User {
    id: ID!
    email: String!
    createdAt: String!
    role: String!
    firstName: String!
    lastName: String!
    birthDate: String!
    phone: String!
}

type Query {
    me: User!
}