scalar UUID
scalar DateTime

enum SeanceStatus {
  OPEN
  PENDING
  CANCELED
  FULL
}

type Club {
  id: UUID!
  name: String
  typeId: UUID
  typeName: String
  city: String
  address: String
  country: String
  postalCode: String
  phoneNumber: String
  email: String
  latitude: Float
  longitude: Float
  ownerId: UUID
  createdAt: DateTime
  updatedAt: DateTime
  deletedAt: DateTime
}

type SeanceDecision {
  id: UUID!
  clubId: UUID!
  status: SeanceStatus!
  refusalReason: String
}

type Query {
  _empty: String
  salut: String
  myClubs(userId: UUID!): [MemberWithClub!]!
  managedClubs(ownerId: UUID!): [Club!]!
  clubMembersByClubId(clubId: UUID!): [MemberWithClub!]!
  clubById(id: UUID!): Club
}

input UserInput {
  userId: UUID!
  firstName: String!
  lastName: String!
  birthDate: DateTime!
  email: String!
  phoneNumber: String
}

type Mutation {
  acceptPendingSeance(seanceId: UUID!, userId: UUID!): SeanceDecision!
  refusePendingSeance(seanceId: UUID!, userId: UUID!, reason: String!): SeanceDecision!
  subscribeToClub(clubId: UUID!, newMember: UserInput!): MemberWithClub
  forcedUnsubscribe(clubId: UUID!, memberId: UUID!): Int
  updateClub(id: UUID!, data: UpdateClubInput!, ownerId: UUID!): Club
  disableClub(id: UUID!, ownerId: UUID!): Boolean
  reactivateClub(id: UUID!, ownerId: UUID!): Boolean

}



type MemberWithClub {
  clubId: UUID!
  userId: UUID!
  firstName: String!
  lastName: String!
  birthDate: DateTime
  email: String!
  phoneNumber: String
  isActif: Boolean
  dateSubscription: String
  dateUnsubscription: String
  himself: Boolean
  club: Club
}

input UpdateClubInput {
  name: String
  typeId: UUID
  typeName: String
  city: String
  address: String
  country: String
  phoneNumber: String
  postalCode: String
  email: String
  latitude: Float
  longitude: Float
  updatedAt: DateTime
}

