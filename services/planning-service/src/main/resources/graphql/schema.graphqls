# ----- Scalars -----
scalar UUID
scalar DateTime

# ----- Enums -----
enum SeanceStatus {
  OPEN
  PENDING
  CANCELED
  FULL
}

# ----- Types -----
type Seance {
    id: UUID!
    idClub: UUID!
    clubName: String!
    adressSeance: String!
    citySeance: String!
    idTerrain: UUID!
    terrainName: String!
    idCoach: UUID
    coachName: String
    startTime: DateTime!
    endTime: DateTime!
    capacite: Int!
    capaSeance: Int!
    idSport: UUID!
    nameSport: String!
    description: String
    status: SeanceStatus!
    createdBy: UUID
    createdAt: DateTime
    updatedAt: DateTime
    refusalReason: String
}

# DTO pratique pour l’UI
type SeanceWithAvailability {
  id: UUID!
  idClub: UUID!
  idTerrain: UUID!
  idCoach: UUID
  startTime: DateTime!
  endTime: DateTime!
  durationMinutes: Int!
  capacite: Int!
  capaSeance: Int!
  remainingPlaces: Int!
  full: Boolean!
  idSport: UUID!
  nameSport: String!
  description: String
  status: SeanceStatus!
  createdBy: UUID
}

# ----- Queries -----
type Query {
  seance(id: UUID!): Seance

  # << méthodes de contrôleur et à tests >>
  seancesByClubBetween(
    clubId: UUID!
    start: DateTime!
    end: DateTime!
  ): [Seance!]!

  seancesByCoachBetween(
    coachId: UUID!
    start: DateTime!
    end: DateTime!
  ): [Seance!]!

  seancesWithAvailabilityByClubBetween(
    clubId: UUID!
    start: DateTime!
    end: DateTime!
  ): [SeanceWithAvailability!]!

    mySeances(start : DateTime
    , end : DateTime
    ): [SeanceWithAvailability!]!
}

type Mutation {
    acceptSeance(seanceId: UUID!, clubId: UUID!): Seance!
    refuseSeance(seanceId: UUID!, clubId: UUID!, reason: String!): Seance!
    # Inscrire un utilisateur à une séance existante.
      # Pour l’instant le service ne gère que la capacité; l’identité de l’utilisateur
      # sera portée par un autre service (membership) via évènement ultérieur.
      joinSeance(id: UUID!): Seance!

      # Désinscrire un utilisateur d'une séance (décrémente la capacité utilisée).
      leaveSeance(id: UUID!): Seance!
}
